<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="-4dp">

        <LinearLayout
            android:id="@+id/layoutScores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@+id/playIniniButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOS 3 MEILLEURS SCORES"
                android:textAlignment="center"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTop1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. --:--"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTop2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. --:--"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTop3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. --:--"
                android:textAlignment="center"
                android:textColor="#DDDDDD"
                android:textSize="16sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/rulesButton"
            android:layout_width="243dp"
            android:layout_height="77dp" android:layout_marginBottom="86dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creditButton"
            app:srcCompat="@drawable/reglesbtn" />

        <ImageView
            android:id="@+id/playIniniButton"
            android:layout_width="242dp"
            android:layout_height="80dp"
            android:layout_marginTop="538dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/creditButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/jouerbtn" />

        <ImageView
            android:id="@+id/creditButton"
            android:layout_width="254dp"
            android:layout_height="77dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toTopOf="@+id/rulesButton"
            app:layout_constraintEnd_toEndOf="@+id/playIniniButton"
            app:layout_constraintStart_toStartOf="@+id/rulesButton"
            app:layout_constraintTop_toBottomOf="@+id/playIniniButton"
            app:srcCompat="@drawable/creditsbtn" />

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="501dp"
            android:layout_height="476dp"
            app:layout_constraintBottom_toTopOf="@+id/playIniniButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.838"
            app:srcCompat="@drawable/blackstar" />

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="318dp"
            android:layout_height="483dp"
            android:layout_marginBottom="152dp"
            app:layout_constraintBottom_toTopOf="@+id/playIniniButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/title" />

        <ImageView
            android:id="@+id/imageView7"
            android:layout_width="604dp"
            android:layout_height="167dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.413"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.28"
            app:srcCompat="@drawable/xwing_acc" />

        <ImageView
            android:id="@+id/imageView19"
            android:layout_width="81dp"
            android:layout_height="69dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toStartOf="@+id/playIniniButton"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView5"
            app:srcCompat="@drawable/star" />

        <ImageView
            android:id="@+id/imageView20"
            android:layout_width="81dp"
            android:layout_height="69dp"
            android:layout_marginTop="237dp"
            app:layout_constraintEnd_toStartOf="@+id/creditButton"
            app:layout_constraintHorizontal_bias="0.656"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/imageView19"
            app:srcCompat="@drawable/star" />

        <ImageView
            android:id="@+id/imageView21"
            android:layout_width="81dp"
            android:layout_height="69dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toStartOf="@+id/rulesButton"
            app:layout_constraintHorizontal_bias="0.343"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView20"
            app:srcCompat="@drawable/star" />

        <ImageView
            android:id="@+id/imageView22"
            android:layout_width="81dp"
            android:layout_height="69dp"
            android:layout_marginEnd="44dp"
            android:layout_marginBottom="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/star" />

        <ImageView
            android:id="@+id/imageView24"
            android:layout_width="81dp"
            android:layout_height="69dp"
            android:layout_marginTop="65dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.698"
            app:layout_constraintStart_toEndOf="@+id/playIniniButton"
            app:layout_constraintTop_toBottomOf="@+id/imageView5"
            app:srcCompat="@drawable/star" />

        <ImageView
            android:id="@+id/imageView25"
            android:layout_width="81dp"
            android:layout_height="69dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toTopOf="@+id/imageView7"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/star" />

        <ImageView
            android:id="@+id/imageView26"
            android:layout_width="81dp"
            android:layout_height="69dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="2dp"
            app:layout_constraintEnd_toStartOf="@+id/imageView6"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/star" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>