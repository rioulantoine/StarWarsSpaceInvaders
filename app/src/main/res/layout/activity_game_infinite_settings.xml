<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GameSettings">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:layout_marginBottom="99dp"
        android:fontFamily="sans-serif-black"
        android:text="Game settings"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/ivBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvBackgroundChoice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="38dp"
        android:layout_marginTop="173dp"
        android:layout_marginEnd="72dp"
        android:fontFamily="sans-serif-medium"
        android:text="Background settings"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/swBackground"
        app:layout_constraintEnd_toStartOf="@+id/ivBg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Switch
        android:id="@+id/swBackground"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginBottom="648dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="Custom background ?"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tvBackgroundChoice"
        app:layout_constraintTop_toBottomOf="@+id/tvBackgroundChoice" />

    <ImageView
        android:id="@+id/ivBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="173dp"
        android:layout_marginEnd="33dp"
        android:layout_marginBottom="477dp"
        app:layout_constraintBottom_toTopOf="@+id/PlayButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvBackgroundChoice"
        app:layout_constraintTop_toTopOf="parent"
        tools:srcCompat="@tools:sample/avatars" />

    <Button
        android:id="@+id/LoadButton"
        android:layout_width="216dp"
        android:layout_height="57dp"
        android:layout_marginStart="36dp"
        android:text="Load background from your gallery"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.294" />

    <Button
        android:id="@+id/PlayButton"
        android:layout_width="229dp"
        android:layout_height="48dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="40dp"
        android:text="Play"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivBg" />

</androidx.constraintlayout.widget.ConstraintLayout>